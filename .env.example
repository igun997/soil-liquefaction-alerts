# Liquefaction Alert Detection System - Environment Variables

# Debug mode (set to True for development)
DEBUG=False

# OpenTopography API Key
# Get your key at: https://opentopography.org/
OPENTOPOGRAPHY_API_KEY=your_api_key_here

# OpenWeatherMap API Key
# Get your key at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_api_key_here

# Google Earth Engine (optional)
# For service account authentication, provide path to JSON key file
# For OAuth authentication, leave empty and authenticate via `earthengine authenticate`
EE_SERVICE_ACCOUNT_KEY=
EE_PROJECT=your_gcp_project_id

# Default map center (optional)
DEFAULT_LATITUDE=0.0
DEFAULT_LONGITUDE=0.0
DEFAULT_ZOOM=2
